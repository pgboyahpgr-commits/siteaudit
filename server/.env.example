# ---- SiteAudit server environment (copy to .env) ----

# Server
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed CORS origins, e.g. http://localhost:5173,https://yourapp.vercel.app
CORS_ORIGIN=http://localhost:5173

# Auth (IMPORTANT: set a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=30d

# AI providers — set at least ONE. All are optional; without any, SiteAudit
# automatically falls back to its built-in local analysis engine (fully working).
# Keys are ONLY read from these server-side env vars, never shipped to the browser.
#
# Provider chain order — the FIRST provider with a valid key wins; every provider is
# tried in order, and if all fail the built-in local engine answers. Google only
# supports ~15 RPM; xAI/Completions give high free budgets — so prefer those first.
AI_PROVIDER=gemini,xai,completions,mistral,nim,openai,anthropic,lmstudio

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# xAI Grok (free credits: https://console.x.ai) — OpenAI-compatible
XAI_API_KEY=
XAI_MODEL=grok-3

# Completions AI (free: https://completions.me) — OpenAI-compatible endpoint
COMPLETIONS_API_KEY=
COMPLETIONS_BASE_URL=https://completions.me/api/v1
COMPLETIONS_MODEL=gemini-2.5-flash

# Mistral AI (free tier: https://console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# NVIDIA NIM (1000 free credits: https://build.nvidia.com)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-r1

# OpenAI / Anthropic (optional premium fallbacks)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# LM Studio — run models locally (100% private, offline-capable, free).
# Enable with LMSTUDIO_ENABLED=1 once LM Studio is installed and a server is
# running (Load a model → Developer → Start Server → URL http://localhost:1234/v1).
# Place LMSTUDIO last in AI_PROVIDER so cloud providers are preferred when present.
LMSTUDIO_ENABLED=
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

# Database — leave unset to use the built-in local SQLite file. Set to a
# PostgreSQL connection string (e.g. a free Supabase project) to use it instead.
#   DATABASE_URL=postgresql://postgres.abcd:password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Email verification (optional) — SendGrid
SENDGRID_API_KEY=
EMAIL_FROM=siteaudit@example.com

# YouTube fix-guide search API (a public innertube/yt proxy returning JSON:
# [{ id, title, author, thumbnail, fullUrl, embedUrl }]). Point this at your own
# proxy or key-based YouTube Data API wrapper if you prefer.
YT_SEARCH_API=https://ytapis.djalokyt27.workers.dev
